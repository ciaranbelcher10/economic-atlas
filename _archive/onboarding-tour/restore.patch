+/* -------------------------- Onboarding tour ----------------------------
+   Liquid-glass green, deliberately toned down from the mako teal used
+   for chart series elsewhere on the site -- distinct enough that a tour
+   box never looks like it could be a chart element, but still clearly
+   drawn from the same palette (mako-5/mako-6) rather than an unrelated
+   colour. backdrop-filter gives the "glass" quality; the site already
+   supports light/dark themes so this is defined against both. */
+.tour-box{
+  position:fixed; z-index:9999; max-width:340px;
+  background:rgba(138,217,177,.16);
+  -webkit-backdrop-filter:blur(14px) saturate(140%);
+  backdrop-filter:blur(14px) saturate(140%);
+  border:1px solid rgba(64,183,173,.45);
+  border-radius:16px;
+  box-shadow:0 12px 40px rgba(0,0,0,.16), 0 0 0 1px rgba(255,255,255,.05) inset;
+  padding:18px 20px;
+  color:var(--ink);
+  opacity:0; transform:translateY(6px);
+  transition:opacity .22s ease, transform .22s ease;
+}
+html[data-theme="dark"] .tour-box{
+  background:rgba(64,183,173,.6);
+  border-color:rgba(138,217,177,.45);
+  box-shadow:0 12px 40px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.04) inset;
+}
+.tour-box.show{opacity:1; transform:translateY(0);}
+.tour-box.tour-center{
+  position:fixed; top:50%; left:50%; transform:translate(-50%,-50%) translateY(6px); max-width:380px;
+}
+.tour-box.tour-center.show{transform:translate(-50%,-50%) translateY(0);}
+.tour-box h4{margin:0 0 8px; font-size:15px; font-weight:700;}
+.tour-box p{margin:0 0 14px; font-size:13.5px; line-height:1.5; color:var(--ink); font-weight:700;}
+.tour-box .tour-row{display:flex; align-items:center; justify-content:flex-end; gap:10px;}
+.tour-box .tour-actions{display:flex; gap:8px;}
+.tour-box button{font:inherit; font-size:12.5px; font-weight:600; border-radius:8px; padding:7px 14px; cursor:pointer; border:1px solid transparent;}
+.tour-box .tour-next{background:var(--mako-5); color:#0d2b26; border-color:var(--mako-5);}
+.tour-box .tour-next:hover{filter:brightness(1.05);}
+.tour-box .tour-prev{background:transparent; color:var(--ink2); border-color:var(--hair);}
+.tour-box .tour-exit{background:none; border:none; color:var(--ink2); font-size:12px; text-decoration:underline; cursor:pointer; padding:4px;}
+.tour-highlight{
+  position:relative; z-index:9998;
+  border-radius:10px;
+  animation:tourPulse 1.6s ease-in-out infinite;
+}
+@keyframes tourPulse{
+  0%, 100% { box-shadow:0 0 0 4px rgba(64,183,173,.9), 0 0 22px 6px rgba(64,183,173,.6), 0 0 0 9999px rgba(0,0,0,.3); }
+  50% { box-shadow:0 0 0 6px rgba(64,183,173,1), 0 0 32px 10px rgba(64,183,173,.85), 0 0 0 9999px rgba(0,0,0,.3); }
+}
+#tourReplayLink{cursor:pointer; background:none; border:none; font:inherit; color:inherit; padding:0;}
